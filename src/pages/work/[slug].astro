---
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Code from "../../components/Code.astro";
import Plate from "../../components/Plate.astro";
import Icon from "../../components/Icon.astro";
import FigureCard from "../../components/FigureCard.astro";
import { figureUrl } from "../../lib/figures";
import { projects, type Project } from "../../lib/projects";
import { ART } from "../../lib/art";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const linkLabel: Record<string, string> = { site: "Website", docs: "Docs", npm: "npm", pypi: "PyPI", demo: "Live demo", crates: "crates.io" };
const extra = Object.entries(p.links).filter(([k, v]) => v && k !== "github" && linkLabel[k]) as [string, string][];
const srcHref = (m: { source: string }) => { const f = m.source.split(":")[0].trim(); return f && !f.includes(" ") ? `https://github.com/${p.repo}/blob/HEAD/${f}` : null; };
const others = projects.filter((o) => o.slug !== p.slug);
const related = [...others.filter((o) => o.category === p.category), ...others.filter((o) => o.category !== p.category).sort((a, b) => b.stars - a.stars)].slice(0, 3);
const idx = projects.findIndex((o) => o.slug === p.slug) + 1;
const version = p.releases[0]?.tag ?? (p.version ? `v${p.version}` : null);
const ld = { "@context": "https://schema.org", "@type": "SoftwareSourceCode", name: p.name, description: p.summary || p.tagline, codeRepository: `https://github.com/${p.repo}`, programmingLanguage: p.language, license: p.license, author: { "@type": "Organization", name: "Halley", url: "https://halleylabs.dev/" } };
---
<Base title={`${p.name}: ${p.tagline} | Halley`} description={p.summary || p.tagline} jsonld={[ld]}>
  <section class="hero"><div class="frame grid-12">
    <div class="h-copy">
      <nav class="crumbs t-data enter" aria-label="Breadcrumb"><a href="/work/">Open source</a><span>/</span><span>{p.category}</span></nav>
      <h1 class="t-h1 enter" style="--d:1">{p.name}</h1>
      <p class="t-lede tag enter" style="--d:2">{p.tagline}</p>
      <div class="acts enter" style="--d:3">
        <Button href={`https://github.com/${p.repo}`} icon="github">View the source</Button>
        {extra.slice(0, 2).map(([k, v]) => <Button href={v} variant="line" icon="arrow-up-right">{linkLabel[k]}</Button>)}
      </div>
    </div>
    <dl class="facts enter" style="--d:2">
      <div><dt class="t-label">Area</dt><dd>{p.category}</dd></div>
      <div><dt class="t-label">Language</dt><dd>{p.language}</dd></div>
      <div><dt class="t-label">License</dt><dd>{p.license}</dd></div>
      {version && <div><dt class="t-label">Latest</dt><dd class="t-data">{version}</dd></div>}
      {p.stars >= 10 && <div><dt class="t-label">Stars</dt><dd class="t-data">★ {p.stars}</dd></div>}
      <div><dt class="t-label">Plate</dt><dd class="t-data">No. {String(idx).padStart(2, "0")} of {projects.length}</dd></div>
    </dl>
  </div></section>

  <section class="stage"><div class="frame">
    {p.demo ? (
      <figure class="demo enter" style={`aspect-ratio:${p.demo.w}/${p.demo.h}`}>
        <video muted loop playsinline preload="none" poster={p.demo.poster} data-autoplay><source src={p.demo.src} type="video/mp4" /></video>
      </figure>
    ) : figureUrl(p.slug) ? (
      <FigureCard slug={p.slug} no={idx} title={p.name} />
    ) : (
      <figure class="engr enter" data-reveal-plate><svg class="art" viewBox="0 0 240 160" aria-hidden="true" set:html={ART[p.slug] ?? ""} /></figure>
    )}
  </div></section>

  {p.demo && figureUrl(p.slug) && (
    <section class="mech"><div class="frame"><FigureCard slug={p.slug} no={idx} title={p.name} /></div></section>
  )}

  {p.metrics.length > 0 && (
    <section class="proof"><div class="frame">
      <p class="t-label lab reveal">What came back</p>
      <ol class="metrics">
        {p.metrics.map((m, i) => { const h = srcHref(m); return (
          <li class="reveal" data-delay={String(i)}>
            <b>{m.value}</b>
            <p>{m.label}.{h && <a class="src t-data" href={h}>source<Icon name="arrow-up-right" size={12} /></a>}</p>
          </li>
        ); })}
      </ol>
    </div></section>
  )}

  <section class="body"><div class="frame grid-12">
    <div class="main">
      <p class="sum reveal">{p.summary}</p>
      {p.how_it_works.length > 0 && (<>
        <h2 class="t-h3 sub reveal">How it works</h2>
        <ol class="steps">{p.how_it_works.map((s, i) => <li class="reveal"><span class="t-data">{String(i + 1).padStart(2, "0")}</span><p>{s}</p></li>)}</ol>
      </>)}
      {p.features.length > 0 && (<>
        <h2 class="t-h3 sub reveal">What it does</h2>
        <ul class="feats">{p.features.map((f) => <li class="reveal">{f}</li>)}</ul>
      </>)}
    </div>
    <aside class="side">
      <div class="sticky">
        {p.install && <Code code={p.install} label="Install" />}
        {p.quickstart && p.quickstart !== p.install && <div class="qs"><Code code={p.quickstart} label="Quickstart" prompt={false} /></div>}
        <a class="repo" href={`https://github.com/${p.repo}`}><Icon name="github" size={18} /><span class="t-data">{p.repo}</span><Icon name="arrow-up-right" size={15} /></a>
      </div>
    </aside>
  </div></section>

  <section class="more"><div class="frame">
    <div class="mh"><h2 class="t-h2">More from the bench</h2><a class="all" href="/work/">All projects<Icon name="arrow-right" size={16} /></a></div>
    <div class="plates">{related.map((o) => <Plate project={o} index={projects.findIndex((x) => x.slug === o.slug) + 1} />)}</div>
  </div></section>
</Base>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]").forEach((v) => {
    if (still) { v.controls = true; return; }
    new IntersectionObserver((e) => e.forEach((x) => { if (x.isIntersecting) { v.preload = "auto"; v.play().catch(() => {}); } else v.pause(); }), { threshold: 0.25 }).observe(v);
  });
</script>

<style>
  .hero { padding: clamp(140px, 15vw, 196px) 0 clamp(48px, 5vw, 72px); }
  .h-copy { grid-column: 1 / span 8; }
  .crumbs { display: flex; gap: 10px; color: var(--color-t3); margin-bottom: 28px; }
  .crumbs a { color: var(--color-t2); } .crumbs a:hover { color: var(--color-t1); }
  .tag { color: var(--color-t2); margin-top: 22px; }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .facts { grid-column: 10 / span 3; align-self: end; margin: 0; border-top: 1px solid var(--color-rule); }
  .facts div { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-rule); }
  .facts dt { color: var(--color-t3); }
  .facts dd { margin: 0; font-size: 15px; }
  .stage { padding-bottom: clamp(64px, 7vw, 104px); }
  .demo, .engr { margin: 0; border-radius: var(--r4); overflow: hidden; }
  .demo { background: var(--color-ink); box-shadow: 0 0 0 1px rgba(12,11,10,.06), 0 60px 100px -60px rgba(40,24,12,.5); }
  .demo video { width: 100%; height: 100%; object-fit: cover; }
  .engr { display: grid; place-items: center; aspect-ratio: 21 / 8; background: var(--color-paper-2); box-shadow: inset 0 0 0 1px var(--color-rule-2); }
  .mech { padding-top: clamp(40px, 5vw, 72px); }
  .engr .art { width: min(78%, 760px); height: auto; color: var(--color-t1); overflow: visible; }
  .engr .art :global(*) { fill: none; stroke: currentColor; stroke-width: 1.1; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .engr .art :global(.f) { stroke: var(--color-t3); opacity: .6; }
  .engr .art :global(.k) { fill: currentColor; stroke: none; }
  .engr .art :global(.fill) { fill: var(--color-paper-2); }
  .engr .art :global(.strong) { stroke-width: 1.8; }
  .engr .art :global(.dash) { stroke-dasharray: 2 5; }
  .engr .art :global(.d:not(.dash)) { stroke-dasharray: var(--len, 600); stroke-dashoffset: var(--len, 600); transition: stroke-dashoffset 2.2s var(--ease); }
  .engr:global(.is-in) .art :global(.d:not(.dash)) { stroke-dashoffset: 0; }
  .proof { padding-bottom: clamp(72px, 8vw, 120px); }
  .lab { color: var(--color-t3); margin-bottom: 26px; }
  .metrics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--col-gap); border-top: 1px solid var(--color-rule); }
  .metrics li { padding-top: 26px; }
  .metrics b { display: block; font: 380 clamp(44px, 4.6vw, 68px)/1 var(--font-serif); font-variation-settings: "opsz" 144, "SOFT" 30; letter-spacing: -0.03em; }
  .metrics p { margin-top: 14px; color: var(--color-t2); font-size: 16px; }
  .src { display: inline-flex; align-items: center; gap: 3px; margin-left: 8px; color: var(--color-t3); white-space: nowrap; border-bottom: 1px solid var(--color-rule); }
  .src:hover { color: var(--color-t1); border-color: currentColor; }
  .body { padding-bottom: clamp(88px, 10vw, 140px); }
  .main { grid-column: 1 / span 7; }
  .sum { margin-bottom: clamp(48px, 5vw, 72px); font: 400 clamp(21px, 1.8vw, 26px)/1.45 var(--font-serif); font-variation-settings: "opsz" 36, "SOFT" 50; letter-spacing: -0.006em; color: var(--color-t1); }
  .sub { margin-bottom: 18px; }
  .steps, .feats { list-style: none; margin: 0 0 clamp(48px, 5vw, 64px); padding: 0; border-top: 1px solid var(--color-rule); }
  .steps li { display: grid; grid-template-columns: 44px 1fr; padding: 16px 0; border-bottom: 1px solid var(--color-rule); color: var(--color-t2); }
  .steps .t-data { color: var(--color-t3); line-height: 1.9; }
  .feats li { position: relative; padding: 16px 0 16px 30px; border-bottom: 1px solid var(--color-rule); color: var(--color-t2); }
  .feats li::before { content: ""; position: absolute; left: 2px; top: 26px; width: 12px; height: 1px; background: var(--color-t1); }
  .side { grid-column: 9 / span 4; }
  .sticky { position: sticky; top: 100px; display: grid; gap: 16px; }
  .repo { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: var(--r3); box-shadow: inset 0 0 0 1px var(--color-rule); color: var(--color-t2); transition: background-color var(--t-hover) var(--ease), color var(--t-hover) var(--ease); }
  .repo .t-data { flex: 1; }
  .repo:hover { background: var(--color-paper-2); color: var(--color-t1); }
  .more { padding-bottom: clamp(96px, 10vw, 140px); }
  .mh { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: var(--head-gap); }
  .all { display: inline-flex; align-items: center; gap: 10px; font-weight: 540; font-size: 15px; padding-bottom: 6px; border-bottom: 1px solid currentColor; }
  .plates { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-rule); border-left: 1px solid var(--color-rule); }
  @media (max-width: 980px) {
    .h-copy, .facts, .main, .side { grid-column: 1 / -1; }
    .facts { margin-top: 40px; }
    .side { margin-top: 8px; }
    .metrics { grid-template-columns: 1fr; }
    .plates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .engr { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 640px) { .plates { grid-template-columns: 1fr; } .mh { flex-direction: column; align-items: flex-start; } }
</style>
