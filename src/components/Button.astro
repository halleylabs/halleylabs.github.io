---
import Icon from "./Icon.astro";
interface Props { href: string; variant?: "solid" | "line" | "light" | "ghost-dark"; icon?: "arrow-right" | "arrow-up-right" | "mail" | "github" | "none"; external?: boolean }
const { href, variant = "solid", icon = "arrow-right", external = false } = Astro.props;
const ext = external || /^https?:|^mailto:/.test(href);
---
<a class:list={["btn", variant]} href={href} {...(ext && !href.startsWith("mailto:") ? { rel: "noopener" } : {})}>
  <span class="label"><slot /></span>
  {icon !== "none" && <span class="ic"><Icon name={icon} size={16} /></span>}
</a>

<style>
  .btn { position: relative; display: inline-flex; align-items: center; gap: 12px; height: 46px; padding: 0 18px 0 20px; border-radius: var(--r3); font: 540 15px/1 var(--font-sans); letter-spacing: -0.003em; white-space: nowrap; overflow: hidden; isolation: isolate; transition: background-color var(--t-hover) var(--ease), color var(--t-hover) var(--ease), box-shadow var(--t-hover) var(--ease), transform var(--t-hover) var(--ease); }
  .btn:active { transform: translateY(1px); }
  .ic { display: inline-grid; place-items: center; width: 16px; height: 16px; overflow: hidden; }
  .ic :global(.ico) { transition: transform var(--t-mark) var(--ease); }
  .solid { background: var(--color-ink); color: var(--color-paper); box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 1px 2px rgba(12,11,10,.18); }
  .solid:hover { background: #24221f; }
  .line { color: var(--color-t1); box-shadow: inset 0 0 0 1px var(--color-rule); background: transparent; }
  .line:hover { background: var(--color-paper-2); box-shadow: inset 0 0 0 1px #cfc8bb; }
  .light { background: var(--color-d1); color: var(--color-ink); box-shadow: inset 0 -1px 0 rgba(0,0,0,.08); }
  .light:hover { background: #fff; }
  .ghost-dark { color: var(--color-d1); box-shadow: inset 0 0 0 1px rgba(236,232,223,.22); }
  .ghost-dark:hover { box-shadow: inset 0 0 0 1px rgba(236,232,223,.45); background: rgba(236,232,223,.04); }
  /* the arrow leaves and comes back from the other side, so it reads as going somewhere */
  @media (hover: hover) and (pointer: fine) {
    .btn:hover .ic :global(.ico) { animation: through .55s var(--ease); }
  }
  @keyframes through { 0% { transform: none; } 45% { transform: translateX(18px); } 46% { transform: translateX(-18px); } 100% { transform: none; } }
</style>
