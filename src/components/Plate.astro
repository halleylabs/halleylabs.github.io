---
import type { Project } from "../lib/projects";
import { starsWorthShowing } from "../lib/projects";
import { ART } from "../lib/art";
import Icon from "./Icon.astro";
import { figureUrl } from "../lib/figures";
interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
const fig = figureUrl(p.slug);
const meta = starsWorthShowing(p) ? `★ ${p.stars}` : p.releases[0]?.tag ?? (p.version ? `v${p.version}` : p.license ?? "");
---
<a class="plate" href={`/work/${p.slug}/`} data-reveal-plate>
  <div class="plate-top">
    <span class="t-label">{p.category}</span>
    <span class="t-label idx">{String(index).padStart(2, "0")}</span>
  </div>
  {fig
    ? <div class="art fig iso" data-theme="light" data-fig={p.slug} data-src={fig} data-mode="hover" role="img" aria-label={`${p.name}, drawn as a working machine`} />
    : <svg class="art" viewBox="0 0 240 160" aria-hidden="true" set:html={ART[p.slug] ?? ""} />}
  <h3 class="t-h3">{p.name}</h3>
  <p class="line">{p.tagline}</p>
  <div class="plate-foot t-data">
    <span>{p.language}</span>
    <span class="go">{meta}<Icon name="arrow-up-right" size={15} /></span>
  </div>
</a>

<script>
  import { mountFigures } from "../lib/figures-client";
  mountFigures();
</script>

<style>
  .art.fig { height: auto; aspect-ratio: 3 / 2; margin: 14px -10px 14px; width: calc(100% + 20px); opacity: 0; transform: translateY(10px); transition: opacity .9s var(--ease) .1s, transform 1.1s var(--ease) .1s; }
  .plate:global(.is-in) .art.fig:global(.is-loaded) { opacity: 1; transform: none; }
  .art.fig :global(svg) { width: 100%; height: 100%; }
  .plate { position: relative; display: flex; flex-direction: column; padding: 26px 26px 22px; min-height: 420px; border-right: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); isolation: isolate; }
  .plate::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 90% at 50% 0%, rgba(255,255,255,.75), rgba(255,255,255,0) 70%); opacity: 0; transition: opacity var(--t-mark) var(--ease); }
  .plate-top { display: flex; justify-content: space-between; color: var(--color-t3); }
  .art { width: 100%; height: 168px; margin: 22px 0 22px; overflow: visible; color: var(--color-t1); }
  h3 { margin-top: auto; }
  .line { margin-top: 10px; color: var(--color-t2); font-size: 15.5px; line-height: 1.5; }
  /* in a multi-column grid every tagline gets the same three-line slot, so titles line up across the row */
  @media (min-width: 641px) { .line { min-height: 4.5em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; } }
  .plate-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 22px; padding-top: 14px; border-top: 1px solid var(--color-rule-2); color: var(--color-t3); }
  .go { display: inline-flex; align-items: center; gap: 8px; }
  .go :global(.ico) { transition: transform var(--t-mark) var(--ease), color var(--t-hover) var(--ease); }
  @media (hover: hover) and (pointer: fine) {
    .plate:hover::before { opacity: 1; }
    .plate:hover .go :global(.ico) { transform: translate(2px, -2px); color: var(--color-t1); }
  }

  /* the engraving: draws itself in when the plate is first seen */
  svg.art :global(*) { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  svg.art :global(.f) { stroke: var(--color-t3); opacity: .6; }
  svg.art :global(.strong) { stroke-width: 1.6; }
  svg.art :global(.k) { fill: currentColor; stroke: none; }
  svg.art :global(.fill) { fill: var(--color-paper); }
  svg.art :global(.dash) { stroke-dasharray: 2 5; }
  svg.art :global(.d:not(.dash)) { stroke-dasharray: var(--len, 600); stroke-dashoffset: var(--len, 600); transition: stroke-dashoffset 1.8s var(--ease); }
  .plate:global(.is-in) svg.art :global(.d:not(.dash)) { stroke-dashoffset: 0; }
  svg.art :global(.k) { opacity: 0; transition: opacity .6s var(--ease) 1s; }
  .plate:global(.is-in) svg.art :global(.k) { opacity: 1; }

  /* one motion per drawing, with a reason */
  svg.art :global(.m-left), .art :global(.m-right), .art :global(.m-slide), .art :global(.m-arm), .art :global(.m-zoom), .art :global(.m-tree), .art :global(.m-drop), .art :global(.m-rows), .art :global(.m-chain) { transition: transform .9s var(--ease); transform-box: view-box; }
  svg.art :global(.m-reel), .art :global(.m-gear) { transform-box: fill-box; transform-origin: center; }
  svg.art :global(.m-waves) :global(path) { transform-box: view-box; transform-origin: 70px 80px; }
  svg.art :global(.m-fan) :global(rect) { transform-box: view-box; transform-origin: 120px 150px; transition: transform .8s var(--ease); }
  svg.art :global(.m-cursor) { offset-path: path("M68 82 C 92 132, 128 70, 160 104"); offset-rotate: 0deg; offset-distance: 0%; transition: offset-distance 1.6s var(--ease); }
  svg.art :global(.m-arm) { transform-origin: 51px 60px; }
  svg.art :global(.m-loop) { transform-box: view-box; transform-origin: 120px 80px; transition: transform 1.2s var(--ease); }
  svg.art :global(.m-zoom) { transform-origin: 132px 78px; }
  @media (hover: hover) and (pointer: fine) {
    .plate:hover svg.art :global(.m-left) { transform: translate(-5px, 2px); }
    .plate:hover svg.art :global(.m-right) { transform: translate(5px, -2px); }
    .plate:hover svg.art :global(.m-waves) :global(path) { animation: ripple 1.6s var(--ease) infinite; }
    .plate:hover svg.art :global(.m-waves) :global(.w2) { animation-delay: .22s; }
    .plate:hover svg.art :global(.m-waves) :global(.w3) { animation-delay: .44s; }
    .plate:hover svg.art :global(.m-reel) { animation: spin 3.6s linear infinite; }
    .plate:hover svg.art :global(.m-fan) :global(.c1) { transform: rotate(-6deg); }
    .plate:hover svg.art :global(.m-fan) :global(.c3) { transform: rotate(5deg); }
    .plate:hover svg.art :global(.m-cursor) { offset-distance: 100%; }
    .plate:hover svg.art :global(.m-slide) { transform: translateX(-56px); }
    .plate:hover svg.art :global(.m-loop) { transform: rotate(-200deg); }
    .plate:hover svg.art :global(.m-chain) { transform: scaleX(.94); transform-origin: 120px 80px; }
    .plate:hover svg.art :global(.m-arm) { transform: rotate(-24deg); }
    .plate:hover svg.art :global(.m-tree) { transform: translateX(-6px); }
    .plate:hover svg.art :global(.m-blink) { animation: blink 1s steps(1) infinite; }
    .plate:hover svg.art :global(.m-gear) { animation: spin 4s linear infinite; }
    .plate:hover svg.art :global(.m-zoom) { transform: scale(1.32); }
    .plate:hover svg.art :global(.m-rows) { transform: translateX(10px); }
    .plate:hover svg.art :global(.m-drop) { transform: translateY(14px); }
  }
  @keyframes ripple { 0% { opacity: 0; transform: scale(.8); } 30% { opacity: 1; } 100% { opacity: 0; transform: scale(1.2); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes blink { 50% { opacity: 0; } }
</style>
