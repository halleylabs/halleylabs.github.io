---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
const path = Astro.url.pathname;
const nav = [
  { href: "/os/", text: "Flagship" },
  { href: "/work/", text: "Open source" },
  { href: "/about/", text: "About" },
];
---
<header class="hd" data-hd>
  <div class="frame bar">
    <a class="brand" href="/" aria-label="Halley, home"><Mark size={22} /><span>halley</span></a>
    <nav aria-label="Main">
      {nav.map((n) => <a href={n.href} class:list={["nl", { on: path.startsWith(n.href) }]}>{n.text}</a>)}
      <a class="nl gh" href="https://github.com/halleylabs" aria-label="Halley on GitHub"><Icon name="github" size={18} /></a>
      <a class="cta" href="/about/#people">Build with us</a>
      <button class="menu" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Menu" data-menu><Icon name="menu" size={20} /></button>
    </nav>
  </div>
  <div class="drawer" id="drawer" data-drawer hidden>
    <div class="frame">
      {nav.map((n) => <a href={n.href}>{n.text}<Icon name="arrow-right" size={18} /></a>)}
      <a href="https://github.com/halleylabs">GitHub<Icon name="arrow-up-right" size={18} /></a>
      <a href="/about/#people">Build with us<Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</header>

<script>
  const hd = document.querySelector<HTMLElement>("[data-hd]")!;
  // The header takes the tone of whatever is under it: light over the night, ink over paper.
  const nights = [...document.querySelectorAll<HTMLElement>("[data-tone='night']")];
  const tone = () => {
    const y = 34;
    const over = nights.some((n) => { const r = n.getBoundingClientRect(); return r.top <= y && r.bottom > y && !n.dataset.dawned; });
    hd.classList.toggle("is-night", over);
    hd.classList.toggle("is-scrolled", scrollY > 8);
  };
  addEventListener("scroll", tone, { passive: true }); addEventListener("resize", tone); addEventListener("halley:tone", tone); tone();
  const btn = document.querySelector<HTMLButtonElement>("[data-menu]")!, drawer = document.querySelector<HTMLElement>("[data-drawer]")!;
  btn.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    drawer.hidden = false;
    requestAnimationFrame(() => hd.classList.toggle("is-open", open));
    if (!open) setTimeout(() => (drawer.hidden = true), 420);
  });
</script>

<style>
  .hd { position: fixed; inset: 0 0 auto 0; z-index: 50; color: var(--color-t1); transition: color .5s var(--ease); }
  .hd::before { content: ""; position: absolute; inset: 0; background: color-mix(in srgb, var(--color-paper) 84%, transparent); backdrop-filter: blur(18px) saturate(1.1); -webkit-backdrop-filter: blur(18px) saturate(1.1); box-shadow: 0 1px 0 var(--color-rule-2); opacity: 0; transition: opacity .5s var(--ease); }
  .hd.is-scrolled::before { opacity: 1; }
  .hd.is-night { color: var(--color-d1); }
  .hd.is-night::before { opacity: 0; }
  .bar { position: relative; display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font: 480 25px/1 var(--font-serif); font-variation-settings: "opsz" 72, "SOFT" 0; letter-spacing: -0.02em; margin-left: -2px; }
  nav { display: flex; align-items: center; gap: 2px; margin-right: -10px; }
  .nl { position: relative; display: inline-flex; align-items: center; height: 40px; padding: 0 12px; font-size: 15px; opacity: .74; transition: opacity var(--t-hover) var(--ease); }
  .nl::after { content: ""; position: absolute; left: 12px; right: 12px; bottom: 8px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform var(--t-mark) var(--ease); }
  .nl:hover, .nl.on { opacity: 1; }
  .nl:hover::after, .nl.on::after { transform: scaleX(1); transform-origin: left; }
  .gh::after { display: none; }
  .cta { margin-left: 10px; display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: var(--r3); font-size: 14.5px; font-weight: 540; box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 34%, transparent); transition: box-shadow var(--t-hover) var(--ease), background-color var(--t-hover) var(--ease); }
  .cta:hover { box-shadow: inset 0 0 0 1px currentColor; }
  .menu { display: none; width: 44px; height: 44px; margin-left: 4px; border: 0; background: none; color: inherit; border-radius: var(--r3); cursor: pointer; place-items: center; }
  .drawer { position: absolute; top: 72px; left: 0; right: 0; background: var(--color-paper); color: var(--color-t1); box-shadow: 0 1px 0 var(--color-rule); clip-path: inset(0 0 100% 0); transition: clip-path .42s var(--ease-io); }
  .drawer .frame { display: grid; padding-block: 8px 20px; }
  .drawer a { display: flex; justify-content: space-between; align-items: center; height: 58px; border-bottom: 1px solid var(--color-rule-2); font: 400 24px/1 var(--font-serif); font-variation-settings: "opsz" 72; letter-spacing: -0.015em; }
  .hd.is-open .drawer { clip-path: inset(0 0 0 0); }
  .hd.is-open { color: var(--color-t1); }
  .hd.is-open::before { opacity: 1; }
  @media (max-width: 820px) {
    .nl, .cta { display: none; }
    .menu { display: inline-grid; }
  }
</style>
