---
// The Halley mark: a disc with a comet cut through it, and the comet's red core.
interface Props { size?: number }
const { size = 22 } = Astro.props;
const id = `hm-${Math.random().toString(36).slice(2, 7)}`;
---
<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <defs><mask id={id}><rect width="100" height="100" fill="#fff" /><path d="M 11.857 70.281 C 29.412 50.164 45.136 39.737 59.739 26.335 A 11.880 11.880 0 1 1 72.189 46.116 C 53.790 53.485 34.392 58.076 11.857 70.281 Z" fill="#000" /></mask></defs>
  <circle cx="50" cy="50" r="40" fill="currentColor" mask={`url(#${id})`} />
  <circle cx="67.772" cy="35.087" r="6.6" fill="#C8371F" />
</svg>
